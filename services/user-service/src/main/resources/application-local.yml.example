# 本地短信调试：复制本文件为 application-local.yml（已在仓库 .gitignore，不会被提交）
#
# 启动 user-service 时启用 profile：
#   mvn spring-boot:run -Dspring-boot.run.profiles=local
# 或环境变量：SPRING_PROFILES_ACTIVE=local
#
# 若密钥曾误提交到 Git，请先到阿里云 RAM 控制台禁用并轮换新的 AccessKey。

aliyun:
  dypns:
    enabled: true
    access-key-id: 在此填写AccessKeyId
    access-key-secret: 在此填写AccessKeySecret
    # 以下若与 application.yml 一致可省略
    # sign-name: 速通互联验证码
    # template-code: "100001"
